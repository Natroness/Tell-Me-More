# Copy to backend/.env and fill in. Never commit .env.

# Supabase: Project Settings > Database > Connection string (use the session pooler, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Settings > API Keys > Secret keys (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy HS256 JWT secret. Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=

# meta | gemini
LLM_PROVIDER=meta
VISION_PROVIDER=meta

META_API_KEY=
# VERIFY against Meta Model API docs (OpenAI-compatible base URL)
META_BASE_URL=
META_CHAT_MODEL=muse-spark-1.3-contributor
META_ASR_MODEL=muse-voice-transcribe-1.0
META_IMAGE_MODEL=muse-image-1.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# English-only Storytime videos. Requires ffmpeg/ffprobe with libass on the worker.
STORYTIME_ENABLED=false
STORYTIME_DAILY_LIMIT_PER_FAMILY=5
STORYTIME_MIN_SECONDS=30
STORYTIME_MAX_SECONDS=75
TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Sulafat
PIXABAY_API_KEY=
# Optional absolute paths if your worker's PATH selects a different FFmpeg build.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

SERAPI_KEY=

# Testing only: email-only instant login (no password, no email link). The frontend
# shows the dev button when VITE_DEV_PASSWORDLESS_LOGIN=true. Keep false in prod.
DEV_PASSWORDLESS_LOGIN=false

# Immersive memories (docs/IMMERSIVE.md). World API v1 key from platform.worldlabs.ai.
WORLDLABS_API_KEY=
WORLDLABS_MODEL=marble-1.0-draft
IMMERSIVE_ENABLED=false
