# Copy to frontend/.env.local. Supabase > Settings > API Keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Testing only: email-only instant login (no password, no link).
# Also needs backend DEV_PASSWORDLESS_LOGIN=true. Keep false/off in prod.
VITE_DEV_PASSWORDLESS_LOGIN=false
